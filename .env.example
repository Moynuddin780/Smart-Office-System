# Copy to .env and fill in. Both marked REQUIRED have no default on purpose:
# a deployment that silently runs on a shipped secret is one where every
# tenant's tokens are forgeable and every database is reachable with a password
# that is in a public repository.

# REQUIRED — the Postgres password.
DB_PASSWORD=

# REQUIRED — the JWT signing key. Generate one:
#   openssl rand -base64 48
JWT_SECRET=

DB_USER=smartoffice
DB_NAME=smartoffice
DB_PORT=5433

HTTP_PORT=8090        # what you open in a browser
APP_PORT=8080         # the app, behind nginx
LOG_LEVEL=info

# The DX-M1 has three cores. Lower this only if another process on this board
# needs one — a core-bound engine claims a task slot, and a second application
# holding the third core makes engine creation here fail outright.
NPU_CORES=3
POSTPROCESS_WORKERS=3

APP_MEM_LIMIT=3g

# Seeds the first SuperAdmin on an empty database, then is never read again.
# Used ONLY to create the first SuperAdmin on an EMPTY database. Changing
# it later does nothing: seeding is skipped whenever a superadmin already
# exists, so these values can never reset or take over a live deployment.
# The seed refuses a password under 10 characters, which is why the value
# below is longer than the one actually in use on this box.
SEED_ADMIN_EMAIL=admin@example.com
SEED_ADMIN_PASSWORD=
